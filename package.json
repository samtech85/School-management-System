{
  "name": "school-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "A starter school management system built with Express, PostgreSQL, and Tailwind CSS.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "css:build": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify",
    "css:watch": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "nodemon": "^3.1.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16"
  },
  "engines": {
    "node": ">=18"
  }
}
